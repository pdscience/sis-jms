---
import Base from "../layouts/Base.astro";
import FormularioAtestado from "../components/FormularioAtestado.vue";
import Icone from "../components/Icone.vue";
import { ensureSeed } from "../lib/seed.js";
import { isDbAvailable } from "../db/index.js";

if (isDbAvailable()) {
  try { await ensureSeed(); } catch { /* sem banco */ }
}

const passos = [
  "O policial militar envia o atestado e recebe o número de protocolo.",
  "A Secretaria confere o documento e marca como \"em análise\".",
  "A Junta de Inspeção de Saúde emite o parecer oficial.",
  "A ata é homologada e o extrato publicado em Boletim Geral.",
];
---
<Base titulo="Enviar atestado | SIS-JIS">
  <main class="min-h-screen bg-campo-50">
    <header class="border-b border-campo-800 bg-campo-900 text-campo-100">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-5">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-campo-800 text-ouro-300"><Icone nome="escudo" className="h-5 w-5" /></span>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-ouro-300">Portal do policial militar</p>
            <h1 class="text-lg font-semibold text-white">Envio digital de atestado médico</h1>
          </div>
        </div>
        <a href="/login" class="rounded-lg border border-campo-700 px-3 py-1.5 text-xs font-semibold text-campo-200 hover:bg-campo-800">Área da Junta</a>
      </div>
    </header>

    <div class="mx-auto grid max-w-5xl gap-6 px-6 py-8 lg:grid-cols-[1.4fr_1fr]">
      <section class="rounded-2xl border border-campo-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-campo-800">Formulário de recepção</h2>
        <p class="mt-1 text-sm text-campo-600">
          Identifique-se com RE e CPF e anexe o documento. A Secretaria da Junta receberá
          o atestado na fila de triagem e emitirá o protocolo de acompanhamento.
        </p>
        <div class="mt-6"><FormularioAtestado client:load canal="militar" /></div>
      </section>

      <aside class="space-y-4">
        <div class="rounded-2xl border border-campo-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-campo-900">Como funciona</h3>
          <ol class="mt-3 space-y-3 text-sm text-campo-700">
            {passos.map((passo, i) => (
              <li class="flex gap-3">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-campo-800 text-xs font-semibold text-ouro-300">{i + 1}</span>
                <span>{passo}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-2xl border border-ouro-300 bg-ouro-100/60 p-5 text-sm text-campo-800">
          <p class="font-semibold">Prazo de apresentação</p>
          <p class="mt-1">
            O atestado deve ser apresentado à OM em até 48 horas da emissão, sob pena de
            apuração de transgressão disciplinar (RDPM). O envio digital não substitui a
            comunicação ao comandante imediato.
          </p>
        </div>
      </aside>
    </div>
  </main>
</Base>
