---
import AppLayout from "../../layouts/AppLayout.astro";
import Card from "../../components/Card.vue";
import CabecalhoPagina from "../../components/CabecalhoPagina.vue";
import FormularioMilitar from "../../components/FormularioMilitar.vue";
import { dadosLayout } from "../../lib/layout-data.js";

const layout = await dadosLayout(Astro);
if (!layout) return Astro.redirect("/login?falha=1");
if (!["admin", "secretaria", "medico"].includes(layout.usuario.papel ?? "")) return Astro.redirect("/militares");
---
<AppLayout usuario={layout.usuario} contadores={layout.contadores}>
  <CabecalhoPagina
    titulo="Novo cadastro de policial militar"
    descricao="Preencha os dados funcionais. O histórico sanitário será construído a partir dos atestados e inspeções."
    migalhas={[{ rotulo: "Policiais Militares", href: "/militares" }, { rotulo: "Novo" }]}
  />
  <Card><FormularioMilitar client:load /></Card>
</AppLayout>
