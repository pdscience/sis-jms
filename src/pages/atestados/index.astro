---
import AppLayout from "../../layouts/AppLayout.astro";
import AtestadosView from "../../components/AtestadosView.vue";
import { dadosLayout } from "../../lib/layout-data.js";

const layout = await dadosLayout(Astro);
if (!layout) return Astro.redirect("/login?falha=1");
if (layout.usuario.papel === "pessoal") return Astro.redirect("/atas");

const status = Astro.url.searchParams.get("status") ?? "todos";
const busca = Astro.url.searchParams.get("busca") ?? "";
const novo = Astro.url.searchParams.get("novo") ?? "";
const militarIdInicial = Number(Astro.url.searchParams.get("militar") ?? "") || null;
---
<AppLayout usuario={layout.usuario} contadores={layout.contadores}>
  <AtestadosView client:load status={status} busca={busca} novo={novo} militarIdInicial={militarIdInicial} />
</AppLayout>
